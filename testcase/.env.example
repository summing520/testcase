# =============================================================================
# DeepSeek（生成测试用例、检查项推断）
# =============================================================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 对话模型：deepseek-v4-pro、deepseek-v4-flash 等，见 DeepSeek API 文档
DEEPSEEK_MODEL=deepseek-v4-flash
# 单次输出 token 上限（默认 8192；不设时易截断长用例）
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# 因 length 截断时自动续写的最大额外轮数（每轮仍受 DEEPSEEK_MAX_OUTPUT_TOKENS 约束）
TCG_MAX_LLM_CONTINUATION_ROUNDS=15
# 续写时每轮附在提示里的前文尾部字符数
TCG_CONTINUATION_TAIL_CHARS=8000

# =============================================================================
# 飞书开放平台（backend/integrations/feishu），文档 / 知识库解析
# =============================================================================
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret

# =============================================================================
# 应用持久化库（backend/db）：任务、用例库、流程配置、检查项记忆
# =============================================================================
APP_DB_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/qa?charset=utf8mb4

# =============================================================================
# 外部业务库只读查询（backend/integrations/database）：表结构 / 采样数据
# =============================================================================
DB_QUERY_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4
# 可选：PostgreSQL 等指定 schema（MySQL 可忽略）
# DB_QUERY_SCHEMA=public

# =============================================================================
# 表结构知识文档（生成用例前同步 docs/knowledge/数据库表结构.md）
# =============================================================================
DB_SCHEMA_DOC_ENABLED=1
# 不参与导出的库名（逗号分隔）
DB_SCHEMA_DOC_IGNORE=mysql,performance_schema,information_schema,sys
# 外键明细表最大行数（节选）
DB_SCHEMA_DOC_GRAPH_MAX_EDGES=2500
# Mermaid 图最大边数（库级 / 每库表级子图各受此上限）
DB_SCHEMA_DOC_MERMAID_MAX_EDGES=100

# =============================================================================
# 用例生成 Agent 上下文截断（均有代码默认值，一般可不配）
# =============================================================================
# 知识库：单文件 / 合计最大字符
TCG_KNOWLEDGE_DOC_MAX_CHARS=22000
TCG_KNOWLEDGE_TOTAL_MAX_CHARS=90000
# 规则文档：单文件 / 合计最大字符
TCG_RULE_DOC_MAX_CHARS=60000
TCG_RULE_DOCS_TOTAL_MAX_CHARS=120000
# 数据库表结构知识文档注入上限
TCG_DB_DOC_MAX_CHARS=60000
# 飞书解析后的需求 Markdown 最大字符
TCG_REQUIREMENT_MAX_CHARS=100000
